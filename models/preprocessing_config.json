{
  "image_size": 224,
  "color_space": "RGB",
  "crop_black_borders": true,
  "pad_to_square": true,
  "apply_clahe": true,
  "clahe_clip_limit": 2.0,
  "clahe_tile_grid_size": [
    8,
    8
  ],
  "normalization_mean": [
    0.485,
    0.456,
    0.406
  ],
  "normalization_std": [
    0.229,
    0.224,
    0.225
  ],
  "train_augmentations": [
    "RandomResizedCrop(scale=(0.86, 1.0), ratio=(0.94, 1.06))",
    "RandomHorizontalFlip(p=0.5)",
    "RandomRotation(degrees=15)",
    "ColorJitter(brightness=0.12, contrast=0.12, saturation=0.08, hue=0.015)"
  ],
  "model_version": "2.0.0-multicenter",
  "backbone_architecture": "efficientnet_b0",
  "any_dr_threshold": 0.545,
  "use_tta": true
}